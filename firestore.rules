rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Global helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return request.auth.token.email_verified == true;
    }

    function isOwner(resourceData) {
      return isSignedIn() && resourceData.ownerId == request.auth.uid;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Classes
    match /classes/{classId} {
      allow read: if isOwner(resource.data);
      allow create: if isSignedIn() && isEmailVerified() 
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.serie is string && request.resource.data.serie.size() > 0 && request.resource.data.serie.size() <= 100
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 100
        && request.resource.data.createdAt == request.time;
      allow update: if isOwner(resource.data) && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.serie is string && request.resource.data.serie.size() > 0 && request.resource.data.serie.size() <= 100
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 100;
      allow delete: if isOwner(resource.data);
    }

    // Students
    match /students/{studentId} {
      allow read: if isOwner(resource.data);
      allow create: if isSignedIn() && isEmailVerified()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 200
        && request.resource.data.classId is string
        && request.resource.data.createdAt == request.time;
      allow update: if isOwner(resource.data) && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 200;
      allow delete: if isOwner(resource.data);
    }

    // Attendance
    match /attendance/{attendanceId} {
      allow read: if isOwner(resource.data);
      allow create: if isSignedIn() && isEmailVerified()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.status in ['P', 'F', '']
        && request.resource.data.bimester in ['1º', '2º', '3º', '4º']
        && request.resource.data.updatedAt == request.time;
      allow update: if isOwner(resource.data) && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.status in ['P', 'F', '']
        && request.resource.data.updatedAt == request.time;
      allow delete: if isOwner(resource.data);
    }

    // Activities
    match /activities/{activityId} {
      allow read: if isOwner(resource.data);
      allow create: if isSignedIn() && isEmailVerified()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.status in ['FEZ', 'NÃO FEZ', 'INCOMPLETO', '']
        && request.resource.data.bimester in ['1º', '2º', '3º', '4º']
        && request.resource.data.updatedAt == request.time;
      allow update: if isOwner(resource.data) && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.status in ['FEZ', 'NÃO FEZ', 'INCOMPLETO', '']
        && request.resource.data.updatedAt == request.time;
      allow delete: if isOwner(resource.data);
    }
  }
}
