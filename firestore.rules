service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Manual access for single-user mode
    function isThiago(data) {
      return data.ownerId == 'thiagorocha';
    }

    // Classes
    match /classes/{classId} {
      allow read, write: if isThiago(request.resource.data) || isThiago(resource.data);
    }

    // Students
    match /students/{studentId} {
      allow read, write: if isThiago(request.resource.data) || isThiago(resource.data);
    }

    // Attendance
    match /attendance/{attendanceId} {
      allow read, write: if isThiago(request.resource.data) || isThiago(resource.data);
    }

    // Activities
    match /activities/{activityId} {
      allow read, write: if isThiago(request.resource.data) || isThiago(resource.data);
    }
  }
}
