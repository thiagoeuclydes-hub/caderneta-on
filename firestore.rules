rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    match /{collection}/{id} {
      // Allow read/delete/update if the existing document belongs to 'thiagorocha'
      allow read, delete, update: if resource != null && resource.data.ownerId == 'thiagorocha';
      
      // Allow create if the new document is being assigned to 'thiagorocha'
      allow create: if request.resource.data.ownerId == 'thiagorocha';
    }
  }
}
